# ==== Sao chép file này thành .env rồi điền giá trị thật. .env KHÔNG commit. ====

# ---- HTTP server ----
# Địa chỉ server lắng nghe. Dùng 0.0.0.0 để nhận kết nối từ LAN.
APP_LISTEN_ADDR=0.0.0.0:8081
# URL công khai mà iPhone nhìn thấy (phải khớp cert TLS). Gồm scheme + host + port.
# Khi chạy sau Caddy TLS thì để https; nếu test HTTP thuần trong LAN thì để http.
APP_PUBLIC_URL=https://192.168.1.55:8081

# ---- Danh tính user (LAN 1-user) ----
APP_USER=me
APP_DISPLAY_NAME=Me

# ---- Thư mục lưu ảnh RAW ----
APP_DATA_DIR=./data

# ---- TLS (chỉ dùng khi server Go TỰ chạy TLS, không qua Caddy) ----
# Để trống cả hai nếu chạy HTTP thuần hoặc đặt sau reverse proxy Caddy.
APP_TLS_CERT=
APP_TLS_KEY=

# ---- PostgreSQL (dùng chung instance Immich, DATABASE RIÊNG) ----
# Ví dụ: postgres://user:password@127.0.0.1:5432/photovault?sslmode=disable
APP_PG_DSN=

# ---- Redis (dùng chung instance Immich, DB INDEX riêng) ----
APP_REDIS_ADDR=127.0.0.1:6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=15
APP_REDIS_PREFIX=photovault:

# ---- Phiên bản Nextcloud giả lập (để qua handshake của app) ----
APP_NC_VERSION=28.0.0.0
APP_NC_VERSION_STRING=28.0.0

# ---- Log ----
# debug | info | warn | error
APP_LOG_LEVEL=debug
