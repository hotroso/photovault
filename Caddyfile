# Caddy đặt TRƯỚC server Go, chỉ làm reverse proxy HTTP thuần trong LAN (KHÔNG TLS).
#
# Đã bỏ HTTPS: cert tự ký của Caddy làm app Nextcloud iOS thỉnh thoảng hỏi lại
# tin cậy cert, mất phiên và phải đồng bộ lại từ đầu.
#
# Cài:  sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

{
	# Không tự cấp cert, không tự chuyển HTTP → HTTPS.
	auto_https off
}

# Cổng 8081 là cổng iPhone trỏ vào (khớp APP_PUBLIC_URL=http://192.168.1.55:8081).
http://192.168.1.55:8081 {
	# Server Go chạy HTTP ở localhost:8090 (khớp APP_LISTEN_ADDR trong .env).
	reverse_proxy 127.0.0.1:8090

	# Cho upload file lớn (video) — nới giới hạn body.
	request_body {
		max_size 5GB
	}
}
